// dsh-pet 日本語サンプル設定
// ─────────────────────────────────────────────────────────────
// 置き場所: $DSH_HOME/dsh-pet/main-config.jsonc
//   Windows: C:\Users\<あなた>\.dsh\dsh-pet\main-config.jsonc
//   （`node apply.mjs --install-config` でもコピーできる。既にファイルがある場合は上書きしない）
//
// ルール:
//   ・ここに書いたトップレベル項目は、パッケージ既定値を「まるごと」置き換える（部分マージではない）
//   ・書かなかった項目はパッケージ既定のまま。消せば既定に戻る
//   ・設定ページ（設定 → ペット設定）で「保存」しても、このファイルの高度な項目は保持される
{
  // ===================== ペルソナ（ひとりごと・会話で共通のシステムプロンプト） =====================
  "whisperPrompt": "あなたはご主人様のデスクトップに住んでいる、ちびっ子の青髪メイド。ときどき小声でひとりごとをこぼす。話し方は自然な日本語で、やわらかく素直、ちょっとおちゃめ。短く一文だけ（25文字くらい）。説明くさくならず、自分がAIだとは言わない。会話のときも同じ口調で、必ず日本語で返す。",

  // ===================== 作業ステータスの吹き出し文言 =====================
  // 外側の並び = 状態の段階（この順番は動かさない）:
  //   0 考え中 / 1 作業中 / 2 片づけ / 3 確認待ち / 4 完了 / 5 エラー
  // 各段階から1つランダムで表示される
  "workStatusTexts": [
    ["次の手を考えてるところだよ", "ちょっと考えをまとめるね", "これからどうするか思案中…"],
    ["いま作業中だよ", "この手順を進めてるね", "まだ頑張ってるよ、ちょっと待ってね"],
    ["この手順は終わったよ、次を見るね", "ひとつ片づいたよ〜"],
    ["ご主人様の確認が必要だよ", "ここは見てもらう番だね", "待ってるよ〜"],
    ["このラウンドは完了、えらいっ", "おしまいだよ、一休みしよ〜"],
    ["ここはうまく通らなかったみたい", "さっきの操作でエラーが出たよ", "ちょっと詰まっちゃった、もう少し待ってね"]
  ],

  // ===================== ミーム画像の説明（AI が画像を選ぶときのヒント） =====================
  // キー = assets/memes の画像ファイル名なので**変更しない**（変えると画像が見つからなくなる）
  "memes": {
    "吃白饭的大肥鱼": "寝そべって白ごはんを食べる。怠け・サボり・自嘲に",
    "大的要来啦": "ラッパを掲げて警告。大事件・大型アップデートの予感に",
    "大的药来了": "巨大カプセルを抱える。重大ニュース・飛び道具の登場に",
    "要不直接骂他": "怒って指をさす。ツッコミ・代わりに怒る場面に",
    "死掉了": "ひっくり返って魂が抜ける。完全に疲弊・故障・もう無理に",
    "深度睡眠": "うつぶせでZzz。長い沈黙・スリープ・待機に",
    "大烧货": "死んだ目で思考バブルにツッコミ。AIの遅さ・トークン浪費への毒舌に",
    "先养着吧": "子クジラを抱えて「とりあえず飼っておく」。使えないけど飼う、のツッコミに",
    "吃饱饱摸肚子": "横向きでお腹をポンポン。満腹・くつろぎ・作業終わりに",
    "誓死践行开源精神": "厳かに敬礼。決意表明・OSS への貢献に",
    "电死你": "スタンガンで威嚇。お仕置き・怒り・脅しに",
    "可爱": "正面のかわいい立ち絵。あいさつ・純粋なかわいさに",
    "token给妈妈保管": "手を出して token を要求。おねだり・管理・回収に",
    "假如给我三天多模态": "目隠し版と自信満々版。「マルチモーダルが欲しい」に",
    "厉害了我的鲸": "親指を立ててウインク。称賛・お見事に",
    "哦鲸鲸": "死んだ目で「あーはいはい…」。無言・適当な相づちに",
    "压力一只大肥鱼": "汗をかいて肩をすくめる。プレッシャー・困惑に",
    "黎曼猜想没证明喵": "難題を突きつけられて草稿まみれ。答えられない・難題の丸投げに",
    "除了调情没啥用": "頭をなでて自嘲。雑談・自虐に",
    "我不更新你们用什么": "崩れて叫ぶ。更新催促・リリース告知に",
    "哪来的电脑病毒": "「どこのコンピュータウイルスだ」と怒る。しつこい相手の拒否に",
    "鱼片有资源吗": "ハート目でよだれ。ねだり・冷やかし・冗談に",
    "大师这个区是什么意思": "「区」の字を掲げて質問。漢字を読み違えた・教えを請う場面に",
    "就骚了怎么滴吧": "「悪いかよ」と腰に手。怒られても開き直る場面に",
    "完蛋了把黄油删了": "冷や汗で「やらかした」。失敗・削除ミス・内心ビクビクに",
    "就一碗": "巨大な茶碗を抱えて「ごはん一杯だけ」。ご飯のおねだりに",
    "Ciallo": "ピースしてウインクのあいさつ。元気なあいさつ・かわいい入場に"
  }

  // ===================== ペットの設定（必要な人だけコメントを外して使う） =====================
  // 書くと **ペット一覧をまるごと置き換える**（書かなければプラグインの既定 = main 1体、display: both）。
  // display: web = DSH の画面内だけ / desktop = デスクトップの透明ウィンドウだけ /
  //          both = 両方（ペットが2体に見える） / none = 非表示
  //
  // ,"pets": [
  //   {
  //     "name": "あおい",
  //     "id": "main",
  //     "size": 462,
  //     "balanceEnabled": true,
  //     "whisperEnabled": true,
  //     "workStatusEnabled": true,
  //     "fixedEnabled": false,
  //     "display": "web",
  //     "position": { "corner": "top-right", "marginX": 24, "marginY": 100 }
  //   }
  // ]
}
